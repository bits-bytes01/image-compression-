program to check the size of .jpg file in KB and convert to binary list

def sz(input_file):
    import os

    file_size = os.path.getsize(input_file)  # returns size in bytes

    print(f"File size: {file_size} bytes")
    print(f"File size: {file_size / 1024:.2f} KB")
    print(f"File size: {file_size / (1024 * 1024):.2f} MB")
    return file_size / 1024